---
import { withBase } from '../lib/base';
import ThemeToggle from './ThemeToggle.astro';
import { tools } from '../tools/registry';
---
<header
  class="sticky top-0 z-40 border-b border-border/70 bg-bg/80 backdrop-blur-lg
         supports-[backdrop-filter]:bg-bg/60"
>
  <div class="mx-auto flex h-14 max-w-5xl items-center gap-3 px-4">
    <a href={withBase('/')} class="flex items-center gap-2.5 font-semibold tracking-tight">
      <img src={withBase('/favicon.svg')} alt="" width="26" height="26" class="rounded-md" />
      <span>工具箱</span>
      <span class="hidden rounded-md bg-surface-2 px-1.5 py-0.5 font-mono text-[10px] font-normal text-fg-subtle sm:inline">
        {tools.length} 个工具
      </span>
    </a>

    <div class="flex-1"></div>

    <!-- 搜索按钮只负责派发事件，命令面板那个岛屿负责响应 -->
    <button
      id="open-palette"
      type="button"
      class="flex h-9 items-center gap-2 rounded-lg border border-border bg-surface px-3
             text-xs text-fg-subtle transition-colors hover:border-fg-subtle/60 hover:text-fg-muted"
    >
      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
      </svg>
      <span class="hidden sm:inline">搜索工具</span>
      <kbd class="hidden rounded border border-border bg-surface-2 px-1.5 font-mono text-[10px] sm:inline">Ctrl K</kbd>
    </button>

    <ThemeToggle />

    <a
      href="https://github.com/TANZHIYU007/toolbox"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub 仓库"
      class="grid size-9 place-items-center rounded-lg text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg"
    >
      <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C16.3 4.7 17.3 5 17.3 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/>
      </svg>
    </a>
  </div>
</header>

<script>
  document.getElementById('open-palette')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toolbox:open-palette'));
  });
</script>
