---
import type { ToolMeta } from '../tools/types';
import { toolPath } from '../lib/base';
import ToolIcon from './ToolIcon';

interface Props {
  tool: ToolMeta;
}
const { tool } = Astro.props;
---
<a
  href={toolPath(tool.id)}
  data-category={tool.category}
  class="tool-card group flex items-start gap-3 rounded-xl border border-border bg-surface p-4
         transition-all duration-150 hover:-translate-y-0.5 hover:border-brand hover:shadow-md"
>
  <span class="shrink-0 rounded-lg bg-brand-soft p-2 text-brand transition-transform duration-150 group-hover:scale-105">
    <ToolIcon name={tool.icon} size={18} />
  </span>
  <span class="min-w-0">
    <span class="block text-sm font-medium text-fg">{tool.name}</span>
    <span class="mt-0.5 block text-xs leading-relaxed text-fg-muted">{tool.description}</span>
  </span>
</a>
