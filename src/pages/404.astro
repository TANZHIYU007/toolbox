---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
---
<BaseLayout title="页面不存在 — 工具箱" description="没有找到这个页面。">
  <div class="flex flex-col items-center py-28 text-center">
    <p class="font-mono text-5xl font-bold text-brand">404</p>
    <h1 class="mt-4 text-xl font-semibold">没有这个页面</h1>
    <p class="mt-2 text-sm text-fg-muted">
      工具可能被改名或还没做出来。按 <kbd class="font-mono">Ctrl</kbd>+<kbd class="font-mono">K</kbd> 搜一下？
    </p>
    <a
      href={withBase('/')}
      class="mt-7 rounded-lg bg-brand px-4 py-2 text-sm font-medium text-brand-fg transition-colors hover:bg-brand-hover"
    >
      回到工具箱
    </a>
  </div>
</BaseLayout>
